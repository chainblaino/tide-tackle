rules_version = '2';

// Tide & Tackle - Firestore security rules.
//
// HOW TO APPLY: firebase deploy --only firestore:rules (or paste this whole
// file into Firebase console -> Firestore Database -> Rules -> Publish).
// Deploy the usernameLogin function FIRST, then these rules, then ship the
// matching index.html, then run tools/strip-public-emails.js (dry-run, then
// --apply) so email fields already stored on users/ and usernames/ are
// removed. Publishing rules does not hide a field that is already on a
// document. Full order: functions/README.md.
//
// These rules do NOT expire (the default "test mode" rules deny everything
// after 30 days). Only signed-in accounts can touch the database; guests never
// do. A player's cloud SAVE is locked to that player so no one else can read or
// wipe it. The shared multiplayer docs (lobbies, positions, invites, friend
// lists) allow cross-account writes because that's how invites / friend
// requests / co-op sessions work.
//
// Player email is NOT stored in Firestore at all. It stays in Firebase Auth
// (password reset, email login, account-deletion reauth). Username login runs
// on the server (functions/index.js: usernameLogin), which reads the email
// from Auth with admin rights, so no client ever needs anyone's email.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Public profiles and the username directory must not carry an email.
    // Checked on create and on update: request.resource is the document AFTER
    // the write, so an update that leaves an existing email in place is denied
    // until that field is deleted.
    function noPublicEmail() {
      return !request.resource.data.keys().hasAny(['email']);
    }

    // ---- A player's cloud save: ONLY the owner may read or write it. ----
    match /saves/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ---- Public profile + stats: anyone signed in can read (friend search,
    //      friends lists, invites); only the owner writes their own.
    //      Email is forbidden. Friend / lobby UI reads username and level. ----
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid && noPublicEmail();
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    match /leaderboard/{uid} {
      allow read:  if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // ---- Username directory (friend search + uniqueness). Readable by any
    //      signed-in user; you may only point a username at YOUR OWN uid.
    //      The doc is {uid} only — email used to live here and let every
    //      signed-in player read every other player's address.
    //      Delete is split out because request.resource is null on a delete, so a
    //      single `write` rule would block you releasing your own username when
    //      you delete your account. ----
    match /usernames/{name} {
      allow read:   if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
                                  && noPublicEmail();
      allow update: if signedIn() && request.resource.data.uid == request.auth.uid
                                  && resource.data.uid == request.auth.uid
                                  && noPublicEmail();
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ---- Server-only collections. Cloud Functions use admin rights and skip
    //      these rules; every client is shut out. loginThrottle counts failed
    //      username logins. loginEmails was a username -> email map in an
    //      earlier draft of this fix; it was never deployed and stays closed. ----
    match /loginThrottle/{name} { allow read, write: if false; }
    match /loginEmails/{name}   { allow read, write: if false; }

    // ---- Social + multiplayer docs need cross-account writes (sending a friend
    //      request or invite writes to the RECIPIENT's doc; lobbies / positions /
    //      challenges are shared), so any signed-in account may read/write. ----
    match /friends/{uid}             { allow read, write: if signedIn(); }
    match /friendRequests/{uid}      { allow read, write: if signedIn(); }
    match /tournamentInvites/{uid}   { allow read, write: if signedIn(); }
    match /tournament_lobbies/{id}   { allow read, write: if signedIn(); }
    match /challenges/{id}           { allow read, write: if signedIn(); }

    // ---- Live positions: every angler owns exactly ONE doc per match, named
    //      "<posKey>__<uid>". Anyone signed in may READ the field (that's how you
    //      see rivals), but you may only write the doc that carries your own uid,
    //      and the uid inside it must be yours, so nobody can shove a rival around
    //      the map or impersonate them. ----
    match /tournament_positions/{id} {
      allow read:   if signedIn();
      allow create, update: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && id == request.resource.data.posKey + '__' + request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
